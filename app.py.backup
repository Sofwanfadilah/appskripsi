# =========================================================
# VISUALISASI BAR CHART
# =========================================================

def plot_brain_wave_bar(
    delta,
    theta,
    alpha,
    beta,
    gamma
):

    data = pd.DataFrame({

        "Gelombang": [

            "Delta",
            "Theta",
            "Alpha",
            "Beta",
            "Gamma"

        ],

        "Power": [

            delta,
            theta,
            alpha,
            beta,
            gamma

        ]

    })

    fig, ax = plt.subplots(
        figsize=(8, 4)
    )

    ax.bar(
        data["Gelombang"],
        data["Power"]
    )

    ax.set_title(
        "Kekuatan Aktivitas Gelombang Otak"
    )

    ax.set_xlabel(
        "Jenis Gelombang"
    )

    ax.set_ylabel(
        "Power"
    )

    return fig


# =========================================================
# RADAR CHART
# =========================================================

def plot_radar_chart(
    delta,
    theta,
    alpha,
    beta,
    gamma
):

    labels = np.array([

        "Delta",
        "Theta",
        "Alpha",
        "Beta",
        "Gamma"

    ])

    values = np.array([

        delta,
        theta,
        alpha,
        beta,
        gamma

    ])

    angles = np.linspace(
        0,
        2 * np.pi,
        len(labels),
        endpoint=False
    )

    values = np.append(values, values[0])
    angles = np.append(
        angles,
        angles[0]
    )

    fig, ax = plt.subplots(

        figsize=(6, 6),

        subplot_kw=dict(
            polar=True
        )

    )

    ax.plot(
        angles,
        values,
        linewidth=2
    )

    ax.fill(
        angles,
        values,
        alpha=0.25
    )

    ax.set_xticks(
        angles[:-1]
    )

    ax.set_xticklabels(
        labels
    )

    ax.set_title(
        "Profil Aktivitas EEG"
    )

    return fig


def plot_waveform_example(brain_wave):
    """Plot illustrative waveforms for all EEG bands and highlight the result."""
    band_frequencies = {
        "Delta": 2,
        "Theta": 6,
        "Alpha": 10,
        "Beta": 20,
        "Gamma": 40,
    }
    colors = {
        "Delta": "#2f6f8f",
        "Theta": "#3d8b76",
        "Alpha": "#e36b42",
        "Beta": "#bc5b78",
        "Gamma": "#7b61a8",
    }
    time = np.linspace(0, 1, 600)
    bands = list(band_frequencies)
    fig, axes = plt.subplots(len(bands), 1, figsize=(10, 6.5), sharex=True)
    fig.patch.set_facecolor("#fbfaf6")
    for axis, band in zip(axes, bands):
        frequency = band_frequencies[band]
        waveform = np.sin(2 * np.pi * frequency * time)
        waveform += 0.18 * np.sin(2 * np.pi * (frequency * 2) * time)
        axis.set_facecolor("#fbfaf6")
        axis.plot(time, waveform, color=colors[band], linewidth=1.6)
        axis.set_ylabel(band, rotation=0, labelpad=28, va="center", fontweight="bold", color=colors[band])
        axis.set_ylim(-1.45, 1.45)
        axis.grid(axis="y", color="#d9d5c9", linewidth=0.6, alpha=0.7)
        axis.spines[["top", "right", "left"]].set_visible(False)
        axis.tick_params(axis="y", left=False, labelleft=False)
        if band == brain_wave:
            axis.axhspan(-1.45, 1.45, color=colors[band], alpha=0.08)
            axis.text(1.01, 0, "hasil", transform=axis.get_yaxis_transform(), color=colors[band], fontweight="bold", va="center")
    axes[-1].set_xlabel("Waktu (detik)")
    axes[-1].set_xlim(0, 1)
    fig.suptitle("Contoh bentuk gelombang otak", x=0.08, ha="left", fontsize=14, fontweight="bold", color="#172326")
    fig.text(0.08, 0.01, "Frekuensi ilustrasi: Delta 2 Hz | Theta 6 Hz | Alpha 10 Hz | Beta 20 Hz | Gamma 40 Hz", fontsize=8, color="#687772")
    fig.tight_layout()
    fig.subplots_adjust(bottom=0.08, top=0.93, left=0.12, right=0.92, hspace=0.22)
    return fig


def plot_original_eeg_signal(signal_df, sampling_rate=200):
    """Plot normalized original EEG channels from the selected recording."""
    channels = ["P4", "Cz", "F8", "T7"]
    signal = signal_df[channels].apply(pd.to_numeric, errors="coerce").dropna()
    signal = signal.iloc[: min(len(signal), sampling_rate * 5)]
    time = np.arange(len(signal)) / sampling_rate
    fig, axis = plt.subplots(figsize=(10, 4.5))
    fig.patch.set_facecolor("#fbfaf6")
    axis.set_facecolor("#fbfaf6")
    for index, channel in enumerate(channels):
        values = signal[channel].to_numpy(dtype=float)
        scale = np.std(values) or 1.0
        normalized = (values - np.mean(values)) / scale
        axis.plot(time, normalized + (len(channels) - index - 1) * 4, linewidth=0.75, label=channel)
    axis.set_title("Sinyal EEG asli dari database", loc="left", fontsize=14, fontweight="bold", color="#172326")
    axis.set_xlabel("Waktu (detik)")
    axis.set_ylabel("Kanal")
    axis.set_yticks([0, 4, 8, 12], ["T7", "F8", "Cz", "P4"])
    axis.grid(axis="x", color="#d9d5c9", linewidth=0.6)
    axis.spines[["top", "right", "left"]].set_visible(False)
    axis.legend(loc="upper right", ncol=4, frameon=False)
    fig.tight_layout()
    return fig


