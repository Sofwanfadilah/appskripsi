# =========================================================
# KONEKSI DATABASE
# =========================================================

def get_connection():

    conn = sqlite3.connect(
        str(DATABASE_PATH),
        check_same_thread=False
    )

    return conn


# =========================================================
# MEMBUAT TABEL DATABASE
# =========================================================

def create_tables():

    conn = get_connection()

    cursor = conn.cursor()

    cursor.execute("""
    CREATE TABLE IF NOT EXISTS eeg_data (

        id INTEGER PRIMARY KEY AUTOINCREMENT,

        created_at TEXT,

        frequency_sound REAL,

        delta_power REAL,

        theta_power REAL,

        alpha_power REAL,

        beta_power REAL,

        gamma_power REAL,

        brain_wave TEXT,

        source TEXT

    )
    """)

    conn.commit()

    conn.close()


# Jalankan pembuatan tabel

create_tables()


# =========================================================
# FUNGSI LOAD DATA
# =========================================================

def load_eeg_data():

    conn = get_connection()

    query = """
    SELECT * FROM eeg_data
    ORDER BY id DESC
    """

    df = pd.read_sql_query(
        query,
        conn
    )

    conn.close()

    return df


def _band_powers(signal, sampling_rate=200):
    """Return mean power in standard EEG bands for one recording."""
    centered = signal - np.mean(signal, axis=0, keepdims=True)
    spectrum = np.abs(np.fft.rfft(centered, axis=0)) ** 2 / len(centered)
    frequencies = np.fft.rfftfreq(len(centered), d=1 / sampling_rate)
    bands = {
        "delta_power": (1, 4),
        "theta_power": (4, 8),
        "alpha_power": (8, 13),
        "beta_power": (13, 30),
        "gamma_power": (30, 45),
    }
    powers = {}
    for name, (low, high) in bands.items():
        mask = (frequencies >= low) & (frequencies < high)
        powers[name] = float(np.mean(spectrum[mask])) if mask.any() else 0.0
    return powers


def extract_audio_frequency(audio_file):
    """Estimate dominant frequency and audio-derived band powers."""
    audio_file.seek(0)
    samples, sample_rate = sf.read(audio_file, dtype="float32", always_2d=False)
    if samples.ndim > 1:
        samples = np.mean(samples, axis=1)
    if samples.size == 0:
        raise ValueError("File audio kosong atau tidak dapat dibaca.")
    spectrum = np.abs(np.fft.rfft(samples))
    frequencies = np.fft.rfftfreq(samples.size, d=1 / sample_rate)
    if spectrum.size < 2 or not np.any(spectrum[1:]):
        raise ValueError("Frekuensi dominan tidak dapat dihitung dari file audio.")
    power_spectrum = spectrum ** 2 / samples.size
    bands = {
        "delta_power": (1, 4),
        "theta_power": (4, 8),
        "alpha_power": (8, 13),
        "beta_power": (13, 30),
        "gamma_power": (30, 45),
    }
    powers = {}
    for name, (low, high) in bands.items():
        mask = (frequencies >= low) & (frequencies < high)
        powers[name] = float(np.mean(power_spectrum[mask])) if mask.any() else 0.0
    return float(frequencies[1:][np.argmax(spectrum[1:])]), powers


def import_dataset_records():
    """Import one feature row per filtered recording into the app database."""
    signal_dir = DATASET_ROOT / "Filtered_Data"
    files = sorted(signal_dir.glob("s*_ex*.csv"))
    if not files:
        raise FileNotFoundError(f"Folder sinyal tidak ditemukan: {signal_dir}")

    imported = 0
    existing = {row[0] for row in load_eeg_data()[["source"]].itertuples(index=False, name=None)}
    for file_path in files:
        source = f"Dataset EEG:{file_path.name}"
        if source in existing:
            continue
        signal_df = pd.read_csv(file_path, usecols=["P4", "Cz", "F8", "T7"])
        powers = _band_powers(signal_df.to_numpy(dtype=float))
        wave = max(powers, key=powers.get).replace("_power", "").title()
        experiment = int(file_path.stem.split("_ex")[1].split("_")[0])
        save_eeg_data(experiment, **powers, brain_wave=wave, source=source)
        imported += 1
    return imported, len(files)


def relabel_dataset_records():
    """Recompute labels for original EEG records from their extracted powers."""
    conn = get_connection()
    try:
        records = pd.read_sql_query(
            "SELECT id, delta_power, theta_power, alpha_power, beta_power, gamma_power "
            "FROM eeg_data WHERE source LIKE 'Dataset EEG:%'",
            conn,
        )
        updates = []
        for record in records.itertuples(index=False):
            powers = {
                "Delta": record.delta_power,
                "Theta": record.theta_power,
                "Alpha": record.alpha_power,
                "Beta": record.beta_power,
                "Gamma": record.gamma_power,
            }
            updates.append((max(powers, key=powers.get), record.id))
        conn.executemany("UPDATE eeg_data SET brain_wave = ? WHERE id = ?", updates)
        conn.commit()
        return len(updates)
    finally:
        conn.close()


def load_database_eeg_signal(source):
    """Load the original four-channel EEG signal behind a database record."""
    prefix = "Dataset EEG:"
    if not str(source).startswith(prefix):
        raise ValueError("Rekaman ini tidak memiliki file sinyal EEG asli.")
    signal_path = DATASET_ROOT / "Filtered_Data" / str(source)[len(prefix):]
    if not signal_path.exists():
        raise FileNotFoundError(f"File sinyal EEG tidak ditemukan: {signal_path.name}")
    return pd.read_csv(signal_path, usecols=["P4", "Cz", "F8", "T7"])


# =========================================================
# MULTI-DATASET IMPORT FUNCTIONS
# =========================================================

def import_multi_dataset(dataset_name: str):
    """Import data dari dataset tertentu"""
    existing_sources = set()
    try:
        df = load_eeg_data()
        if len(df) > 0:
            existing_sources = set(df["source"].tolist())
    except:
        pass
    
    imported = 0
    
    if dataset_name == "Auditory Dataset":
        records, msg = load_auditory_dataset()
    elif dataset_name == "Motor Imagery Dataset":
        records, msg = load_motor_imagery_edf()
    elif dataset_name == "GDF Dataset":
        records, msg = load_gdf_dataset()
    elif dataset_name == "BIDS Dataset":
        records, msg = load_bids_dataset()
    else:
        return 0, f"Dataset '{dataset_name}' tidak dikenal"
    
    for record in records:
        if record["source"] not in existing_sources:
            try:
                save_eeg_data(**record)
                imported += 1
            except Exception as e:
                print(f"Error saving record: {e}")
                continue
    
    return imported, msg


# =========================================================
# FUNGSI MENYIMPAN DATA
# =========================================================

def save_eeg_data(
    frequency_sound,
    delta_power,
    theta_power,
    alpha_power,
    beta_power,
    gamma_power,
    brain_wave,
    source="Manual Input"
):

    conn = get_connection()

    cursor = conn.cursor()

    created_at = datetime.now().strftime(
        "%Y-%m-%d %H:%M:%S"
    )

    cursor.execute("""
    INSERT INTO eeg_data (

        created_at,
        frequency_sound,
        delta_power,
        theta_power,
        alpha_power,
        beta_power,
        gamma_power,
        brain_wave,
        source

    )

    VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)

    """, (

        created_at,
        frequency_sound,
        delta_power,
        theta_power,
        alpha_power,
        beta_power,
        gamma_power,
        brain_wave,
        source

    ))

    conn.commit()

    conn.close()


# =========================================================
# HAPUS DATA
# =========================================================

def delete_eeg_data(data_id):

    conn = get_connection()

    cursor = conn.cursor()

    cursor.execute(
        "DELETE FROM eeg_data WHERE id = ?",
        (data_id,)
    )

    conn.commit()

    conn.close()


# =========================================================
# SIMPAN MODEL
# =========================================================

def save_model(model, features):

    model_data = {

        "model": model,

        "features": features

    }

    with open(
        MODEL_PATH,
        "wb"
    ) as file:

        pickle.dump(
            model_data,
            file
        )


# =========================================================
# LOAD MODEL
# =========================================================

def load_model():

    if os.path.exists(MODEL_PATH):

        try:
            with open(MODEL_PATH, "rb") as file:
                model_data = pickle.load(file)
            if not isinstance(model_data, dict) or "model" not in model_data or "features" not in model_data:
                return None
            return model_data
        except (EOFError, OSError, pickle.UnpicklingError):
            return None

    return None


